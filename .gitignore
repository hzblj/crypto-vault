# Dependencies
node_modules/

# Yarn (node-modules linker: only the release/plugins are committed)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Turborepo
.turbo

# Package build output
packages/*/build/
*.tgz

# Gradle and CMake output of the module's Android half
packages/*/android/build/
packages/*/android/.cxx/
packages/*/android/.gradle/

# Expo
.expo/
expo-env.d.ts
web-build/
dist/

# Native projects of the example app are generated by prebuild
apps/example/ios/
apps/example/android/

# Maestro's reports and screenshots
apps/example/e2e/output/

# Native secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# Metro
.metro-health-check*

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo

# Editors and agents
.claude/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# System
.DS_Store
Thumbs.db

# Env
.env*
!.env.example

# pack-check scratch
.pack-check/
