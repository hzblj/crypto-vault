{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "cryptovault"
  ],
  "ios": {
    "iosModuleName": "CryptoVault"
  },
  "android": {
    "androidNamespace": [
      "cryptovault"
    ],
    "androidCxxLibName": "CryptoVault"
  },
  "autolinking": {
    "CryptoVault": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridCryptoVault"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "build"
  ]
}
