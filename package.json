{
  "name": "crypto-vault-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "example": "yarn workspace crypto-vault-example",
    "start": "yarn example start",
    "ios": "yarn example ios",
    "android": "yarn example android",
    "prebuild": "yarn example expo:prebuild",
    "build": "yarn turbo run build --filter='./packages/*'",
    "codegen": "yarn workspace @hzblj/crypto-vault codegen",
    "typecheck": "yarn turbo run tsc:check",
    "lint": "yarn turbo run lint",
    "test": "yarn turbo run test",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "format": "biome format --write .",
    "pack:check": "yarn build && node ./scripts/pack-check.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node ./scripts/sync-versions.mjs && yarn install --mode=update-lockfile",
    "release": "yarn build && yarn workspaces foreach --all --no-private --topological npm publish --tolerate-republish && changeset tag",
    "clean": "rm -rf .turbo node_modules/.cache/turbo && find . -name '.turbo' -type d -prune -exec rm -rf '{}' + && yarn example clean:native"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@hzblj/biome-config": "^0.2.1",
    "concurrently": "^10.0.5",
    "turbo": "^2.10.12",
    "typescript": "~7.0.2"
  },
  "packageManager": "yarn@4.18.0"
}
